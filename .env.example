# Bale Bot Token (دریافت از BotFather در بله)
BALE_BOT_TOKEN=your_bale_bot_token_here

# شناسه عددی ادمین در بله (اختیاری - در صورت خالی بودن، اولین کاربری که /start بزند ادمین می‌شود)
ADMIN_USER_ID=

# کلید API ایتا یار (دریافت از eitaayar.ir) - قابل تنظیم در داشبورد بله
EITAA_API_TOKEN=

# شناسه یا نام کاربری کانال مقصد در ایتا (بدون @ یا شناسه عددی) - قابل تنظیم در داشبورد بله
EITAA_CHANNEL_ID=

# شناسه کانال مبدا در بله (مثلاً -100xxxxxxx یا @channel_username) - قابل تنظیم در داشبورد بله
BALE_CHANNEL_ID=

# مسیر ذخیره تنظیمات دائمی
DATA_STORAGE_PATH=bot_data.json
